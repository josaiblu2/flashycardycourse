# Copy this file to .env.local and replace placeholders with your own values.
# .env.local is gitignored — never commit real secrets to the repository.
#
# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon Postgres — https://neon.tech
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=sk-...

# Admin access (comma-separated Clerk user IDs)
# ADMIN_CLERK_USER_IDS=user_abc123,user_def456

# AI usage limits for demo mode (optional — defaults shown)
# AI_USER_DAILY_LIMIT=3
# AI_USER_MONTHLY_LIMIT=20
# AI_GLOBAL_MONTHLY_LIMIT=100

# Billing — set to true only when Clerk Billing checkout is ready for production
# BILLING_ENABLED=false
